{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/products", "destination": "/category.html" },
    { "source": "/products.html", "destination": "/category.html" },
    { "source": "/products_en", "destination": "/category_en.html" },
    { "source": "/products_en.html", "destination": "/category_en.html" },
    { "source": "/product", "destination": "/product_details.html" },
    { "source": "/product.html", "destination": "/product_details.html" },
    { "source": "/product_en", "destination": "/product_details_en.html" },
    { "source": "/product_en.html", "destination": "/product_details_en.html" },
    { "source": "/signin", "destination": "/login.html" },
    { "source": "/register", "destination": "/signup.html" },
    { "source": "/signin_en", "destination": "/login_en.html" },
    { "source": "/register_en", "destination": "/signup_en.html" },
    { "source": "/cart", "destination": "/cart.html" },
    { "source": "/cart.html", "destination": "/cart.html" },
    { "source": "/checkout", "destination": "/cart.html" },
    { "source": "/cart_en", "destination": "/cart_en.html" },
    { "source": "/cart_en.html", "destination": "/cart_en.html" },
    { "source": "/checkout_en", "destination": "/cart_en.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/(css|js|img|fonts|Toki/css|Toki/js|Toki/img|Toki/fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
